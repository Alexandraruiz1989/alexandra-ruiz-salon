# Alexandra Ruiz Salon - variables de entorno de ejemplo
#
# Copia este archivo como .env.local y completa los valores en tu entorno.
# Nunca guardes valores reales, tokens, contrasenas o llaves privadas en Git.

# Requeridas para desarrollo de la app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URLs publicas de la aplicacion
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Citas transaccionales: mantener apagadas salvo prueba controlada
APPOINTMENT_TRANSACTIONAL_WRITES_ENABLED=false
APPOINTMENT_ADMIN_TRANSACTIONAL_WRITES_ENABLED=false
APPOINTMENT_PORTAL_TRANSACTIONAL_WRITES_ENABLED=false
NEXT_PUBLIC_APPOINTMENT_TRANSACTIONAL_WRITES_ENABLED=false
NEXT_PUBLIC_APPOINTMENT_ADMIN_TRANSACTIONAL_WRITES_ENABLED=false
NEXT_PUBLIC_APPOINTMENT_PORTAL_TRANSACTIONAL_WRITES_ENABLED=false

# Meta Embedded Signup: variables publicas, sin secretos
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
NEXT_PUBLIC_META_SDK_VERSION=v26.0

# WhatsApp / bot: privadas y apagadas por defecto
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
BOT_WEBHOOK_RECEIVE_ENABLED=false
BOT_INBOUND_PROCESSING_ENABLED=false
BOT_DRAFT_GENERATION_ENABLED=false
BOT_OUTBOUND_SEND_ENABLED=false
BOT_APPOINTMENT_WRITES_ENABLED=false
BOT_AI_ENABLED=false
BOT_WEBHOOK_MAX_BODY_BYTES=524288

# IA opcional para pruebas internas del bot
OPENAI_API_KEY=
OPENAI_MODEL=

# Push notifications opcional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Desarrollo local opcional
LOCAL_SALON_PORT=3000
LOCAL_SUPABASE_URL=
LOCAL_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_DB_URL=

# Pruebas opcionales
BOT_TEST_SERVICE_CATALOG_PATH=
